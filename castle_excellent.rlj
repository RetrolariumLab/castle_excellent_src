schema = "retrolarium.game"
schema_version = 1

# Opened by Retrolarium Studio: pick a version, and the studio checks its ROM,
# splits the assets and keeps your edits in hack/<version>/ (not tracked).

[game]
id = "castle-excellent"
name = "Castle Excellent / Castlequest"
platform = "nes"
profile = "castle-excellent.v1"

[[revisions]]
id = "castle-excellent-japan-hsp-05"
label = "Castle Excellent · Japan"
rom = "Castle Excellent (J).nes"

[[revisions]]
id = "castlequest-usa"
label = "Castlequest · USA"
rom = "Castlequest (U) [!].nes"

# The assets both revisions build from: the kit cuts them out of the ROMs by
# assets/manifest.json, as `make split` does.
[split]
revision = "castle-excellent-japan-hsp-05"
manifest = "assets/manifest.json"
