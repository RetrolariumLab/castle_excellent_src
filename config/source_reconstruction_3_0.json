  "delta": [
    {
      "id": "retrolarium-descriptor",
      "kind": "tooling",
      "summary": "castle_excellent.rlj names the game, its kit profile castle-excellent.v1, the revisions it builds and its asset split; the studio views come from the kit's profile."
    },
    {
      "id": "editing-moves-to-retrolarium",
      "kind": "tooling",
      "summary": "The editors, their models, the workspace composer, the UI smokes and their tests, Make targets and documentation are removed; editing happens in Retrolarium Studio over hack/<revision>/ (docs/retrolarium.md)."
    },
    {
      "id": "studio-check",
      "kind": "validation",
      "summary": "make studio-check: in a throwaway copy the kit prepares, validates and rebuilds every revision with no edits, byte for byte."
    },
    {
      "id": "tag-bound-2x-audits",
      "kind": "validation",
      "summary": "The 2.x manifests describe their tags' trees, so their audits run at the tag in a disposable clone; the functional 2.x gate stays on HEAD."
    },
    {
      "id": "community-names",
      "kind": "source",
      "summary": "Community object names and annotated handler tables, recorded as source_replacements in config/reconstruction/source_layout.json so make disassemble reproduces them; the collision module splits at $903F into collision/handlers.asm."
    },
    {
      "id": "absolute-tool-paths",
      "kind": "tooling",
      "summary": "The profile build runs ca65 and ld65 by absolute path."
    },
    {
      "id": "kit-toolchain",
      "kind": "toolchain",
      "summary": "The repository no longer carries ca65 and ld65: CA65 and LD65 default to the cc65 Retrolarium Kit builds and ships (the same 2.19 0fca835), and build-toolchain-status checks them against this manifest's toolchain by size, SHA-256 and version; bin/ is gone."
    },
    {
      "id": "shared-linter",
      "kind": "tooling",
      "summary": "make lint and make format run Retrolarium Kit's shared linter (rltool lint) over config/lint.json: the ca65 style for src and the text contract with two-space JSON; asm_style.py, format_project.py and their tests move to the kit. build.project lint and the Python source policy stay here."
    }
  ],
