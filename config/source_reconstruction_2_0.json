      "id": "expanded-rom-and-general-relocation",
      "status": "planned",
      "reason": "Source 2.0 will prove isolated fixed-layout edits; systematic relocation remains outside its release boundary."
    },
    {
      "id": "graphical-content-studio",
      "status": "planned",
      "reason": "Headless codecs and models are required before an optional GUI is accepted."
    },
    {
      "id": "sibling-engine-reconstruction",
      "status": "unsupported",
      "reason": "The Castle and non-NES engines require a separate major architectural decision."
    }
  ],
  "delta": [
    {
      "id": "source-2-release-boundary",
      "kind": "documentation",
      "summary": "Define the Source 2.0 inheritance, profile, experimental-build, authoring, and aggregate-gate contracts.",
      "evidence": [
        "docs/source_reconstruction_2_0.md"
      ]
    },
    {
      "id": "castlequest-reference-survey",
      "kind": "evidence",
      "summary": "Pin the USA reference identity and map its 26 changed PRG bytes to four existing semantic modules.",
      "evidence": [
        "config/revision_profiles.json",
        "docs/revision_profiles.md"
      ]
    },
    {
      "id": "castlequest-shared-source-build",
      "kind": "source-and-build",
      "summary": "Build the USA localization byte-identically from the common entrypoint, semantic revision conditionals, and isolated private binary assets.",
      "evidence": [
        "src/revisions/profile.inc",
        "scripts/revision_profiles.py",
        "tests/test_revision_profiles.py"
      ]
    },
    {
      "id": "castlequest-direct-runtime",
      "kind": "runtime-evidence",
      "summary": "Observe Castlequest's 50-life startup and three-entry localized sub-command menu directly in pinned FCEUX while excluding the Japanese load/save handlers.",
      "evidence": [
        "scenarios/source_2_castlequest.json",
        "scripts/capture_castlequest_runtime.lua",
        "scripts/revision_runtime.py",
        "tests/test_revision_runtime.py"
      ]
    },
    {
      "id": "revision-binary-data-split",
      "kind": "source-and-provenance",
      "summary": "Extract each profile's CHR, title palette, and sub-command text from its private ROM under explicit size and hash contracts while forbidding undeclared PRG binary includes.",
      "evidence": [
        "config/revision_profiles.json",
        "config/source_layout.json",
        "scripts/revision_profiles.py",
        "scripts/generate_disassembly.py",
        "docs/revision_profiles.md"
      ]
    },
    {
      "id": "level-authoring-pipeline",
      "kind": "authoring",
      "summary": "Add a profile-aware JSON workspace, fixed-capacity encoder, and visual Studio for all room maps, objects, pointers, counts, and persistent-state offsets.",
      "evidence": [
        "config/level_authoring.json",
        "scripts/level_editor.py",
        "scripts/level_studio.py",
        "scripts/level_studio_model.py",
        "tests/test_level_editor.py",
        "tests/test_level_studio_model.py",
        "docs/content_authoring.md"
      ]
    },
    {
      "id": "level-point-playtest",
      "kind": "authoring-runtime",
      "summary": "Launch an authored profile in pinned FCEUX, select any of the 100 rooms through the normal new-game and room-load path, and place the player at a validated room coordinate.",
      "evidence": [
        "scripts/level_playtest.py",
        "scripts/level_playtest.lua",
        "tests/test_level_playtest.py",
        "docs/content_authoring.md"
      ]
    },
    {
      "id": "music-authoring-pipeline",
      "kind": "authoring",
      "summary": "Decode and rebuild all eight music track sets and 21 textual MML streams through a profile-aware fixed-capacity workspace, then expose the same validated codec through a thin visual studio.",
      "evidence": [
        "config/audio_authoring.json",
        "scripts/music_editor.py",
        "scripts/sound_studio.py",
        "scripts/sound_studio_model.py",
        "tests/test_music_editor.py",
        "tests/test_sound_studio_model.py",
        "docs/content_authoring.md"
      ]
    },
    {
      "id": "graphics-authoring-pipeline",
      "kind": "authoring",
      "summary": "Decode and rebuild two graphics-only CHR banks plus fixed PRG display, palette, metasprite, localized-text, and sound-effect parameter records, then expose them through a visual pixel and record editor without claiming ownership of the room-data CHR banks.",
      "evidence": [
        "config/graphics_authoring.json",
        "scripts/graphics_editor.py",
        "scripts/graphics_studio.py",
        "scripts/graphics_studio_model.py",
        "tests/test_graphics_editor.py",
        "tests/test_graphics_studio_model.py",
        "docs/content_authoring.md"
      ]
    },
    {
      "id": "fixed-layout-start-room-variant",
      "kind": "experimental-build",
      "summary": "Build a one-byte starting-room variant under an exact changed-byte allowlist and observe the replacement through the normal boot path in pinned FCEUX.",
      "evidence": [
        "config/fixed_layout_variants.json",
        "scripts/fixed_layout_variant.py",
        "scripts/validate_fixed_layout.lua",
        "tests/test_fixed_layout_variant.py",
        "docs/fixed_layout_variants.md"
      ]
    }
